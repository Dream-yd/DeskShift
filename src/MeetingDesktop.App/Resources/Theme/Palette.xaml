<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">




  <Color x:Key="Color.Brand.900">#FF0D24A5</Color>
  <Color x:Key="Color.Brand.800">#FF1233B8</Color>
  <Color x:Key="Color.Brand.700">#FF1544CD</Color>
  <Color x:Key="Color.Brand.600">#FF1E55DC</Color>
  <Color x:Key="Color.Brand.500">#FF2963E9</Color>
  <Color x:Key="Color.Brand.400">#FF3F86F9</Color>
  <Color x:Key="Color.Brand.300">#FF6B9EF3</Color>
  <Color x:Key="Color.Brand.200">#FFA9C6F8</Color>
  <Color x:Key="Color.Brand.100">#FFD3E2FC</Color>
  <Color x:Key="Color.Brand.050">#FFEEF4FB</Color>

  <Color x:Key="Color.Accent.Cyan">#FF1BD3E9</Color>
  <Color x:Key="Color.Accent.CyanDim">#FF14A8BA</Color>


  <Color x:Key="Color.Ink.Strong">#FF17243B</Color>
  <Color x:Key="Color.Ink.Primary">#FF26354B</Color>
  <Color x:Key="Color.Ink.Secondary">#FF526278</Color>
  <Color x:Key="Color.Ink.Muted">#FF5C6C80</Color>
  <Color x:Key="Color.Ink.OnLight">#FF10214F</Color>


  <Color x:Key="Color.Status.Success">#FF16744A</Color>
  <Color x:Key="Color.Status.Warning">#FF865500</Color>
  <Color x:Key="Color.Status.Danger">#FFBC3445</Color>


  <!-- Opaque canvas is the default; native backdrop replaces only the window-local background. -->
  <SolidColorBrush x:Key="Brush.CanvasTint" Color="#BFF1F4F8" />
  <SolidColorBrush x:Key="Brush.DesktopBackdrop" Color="Transparent" />
  <SolidColorBrush x:Key="Brush.DesktopVeil" Color="#CF081224" />
  <SolidColorBrush x:Key="Brush.Window" Color="#FFF1F4F8" />
  <SolidColorBrush x:Key="Brush.Panel" Color="#BDEAF0F8" />
  <SolidColorBrush x:Key="Brush.Card" Color="#DFFFFFFF" />
  <SolidColorBrush x:Key="Brush.CardHover" Color="#FFF7FAFF" />
  <SolidColorBrush x:Key="Brush.CardSelected" Color="#FFE4EDFF" />
  <SolidColorBrush x:Key="Brush.Sunken" Color="#FFE8EEF5" />
  <SolidColorBrush x:Key="Brush.Hairline" Color="#FFD3DDE9" />


  <LinearGradientBrush x:Key="Brush.WindowGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FFF5F7FB" Offset="0" />
    <GradientStop Color="#FFF0F4FA" Offset="0.55" />
    <GradientStop Color="#FFE9EFF8" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.BrandGradient" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#FF2963E9" Offset="0" />
    <GradientStop Color="#FF3F86F9" Offset="1" />
  </LinearGradientBrush>


  <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Ink.Primary}" />
  <SolidColorBrush x:Key="Brush.Text.Strong" Color="{StaticResource Color.Ink.Strong}" />
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Ink.Secondary}" />
  <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource Color.Ink.Muted}" />
  <SolidColorBrush x:Key="Brush.Text.OnLight" Color="{StaticResource Color.Ink.OnLight}" />


  <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Brand.500}" />
  <SolidColorBrush x:Key="Brush.PrimaryHover" Color="{StaticResource Color.Brand.600}" />
  <SolidColorBrush x:Key="Brush.PrimaryPressed" Color="{StaticResource Color.Brand.700}" />
  <SolidColorBrush x:Key="Brush.PrimaryDisabled" Color="#FFA6B9DC" />

  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Brand.500}" />
  <SolidColorBrush x:Key="Brush.AccentDim" Color="{StaticResource Color.Brand.700}" />

  <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Status.Success}" />
  <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Status.Warning}" />
  <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Status.Danger}" />


  <CornerRadius x:Key="Radius.Small">10</CornerRadius>
  <CornerRadius x:Key="Radius.Medium">16</CornerRadius>
  <CornerRadius x:Key="Radius.Large">20</CornerRadius>

  <Thickness x:Key="Padding.Card">22</Thickness>
  <Thickness x:Key="Padding.Control">14,8</Thickness>

  <sys:Double x:Key="FontSize.Body">14</sys:Double>
  <sys:Double x:Key="FontSize.Title">26</sys:Double>
  <sys:Double x:Key="FontSize.Heading">17</sys:Double>
  <sys:Double x:Key="FontSize.Caption">13</sys:Double>

  <SolidColorBrush x:Key="Brush.Input" Color="White" />
  <SolidColorBrush x:Key="Brush.SelectionText" Color="{StaticResource Color.Brand.700}" />
  <SolidColorBrush x:Key="Brush.OnPrimary" Color="White" />
  <SolidColorBrush x:Key="Brush.DangerSurface" Color="#FFFCECEF" />
</ResourceDictionary>
